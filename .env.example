# Copy to .env.local and fill in. Without these, home.os runs in demo mode
# (data stays in this browser, sign-in is simulated).

# Supabase project (Project Settings -> API). The anon key is public by design.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Web Push public key (generate a pair with: npx web-push generate-vapid-keys).
# The private key goes in the Edge Function secrets, never here.
VITE_VAPID_PUBLIC_KEY=

# Optional: serve the app from a sub-path, e.g. /homeos/
# VITE_BASE=/
